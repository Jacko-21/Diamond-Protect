---
// Diamant taille brillant vu de profil, en filaire : le motif de marque.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const girdle = [40, 93, 147, 200, 253, 307, 360];
const table = [120, 160, 200, 240, 280];
const crown = [[40,110],[120,40],[93,110],[160,40],[147,110],[200,40],[253,110],[240,40],[307,110],[280,40],[360,110]];
---
<svg class={`diamant ${cls}`} viewBox="0 0 400 300" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id="glint" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="currentColor" stop-opacity="0.25" />
      <stop offset="0.5" stop-color="currentColor" stop-opacity="1" />
      <stop offset="1" stop-color="currentColor" stop-opacity="0.25" />
    </linearGradient>
  </defs>
  <g stroke="url(#glint)" stroke-width="1" stroke-linejoin="round">
    <polygon points="120,40 280,40 360,110 200,280 40,110" />
    <line x1="40" y1="110" x2="360" y2="110" />
    <polyline points={crown.map((p) => p.join(',')).join(' ')} />
    {girdle.map((x) => <line x1={x} y1="110" x2="200" y2="280" />)}
    {table.slice(1, -1).map((x) => <line x1={x} y1="40" x2={x} y2="46" />)}
    <polyline points="93,110 200,190 307,110" />
    <polyline points="147,110 200,150 253,110" />
  </g>
  <g fill="currentColor">
    {girdle.map((x) => <circle cx={x} cy="110" r="2.2" />)}
    <circle cx="200" cy="280" r="2.6" />
  </g>
</svg>
<style>
  .diamant { color: var(--teal-bright); }
</style>
