---
import { clients } from '../data/site';
---
<section class="clients light" id="references" aria-labelledby="clients-titre">
  <div class="container in">
    <div class="intro">
      <p class="label">Références</p>
      <h2 id="clients-titre">Collectivités, enseignes et industriels nous confient leur sûreté.</h2>
    </div>
    <ul class="logos">
      {clients.map((c) => (
        <li><img src={`clients/${c.fichier}`} alt={c.nom} loading="lazy" /></li>
      ))}
    </ul>
  </div>
</section>
<style>
  .clients { padding-block: clamp(56px, 7vw, 88px); }
  .in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .intro { display: grid; gap: 16px; }
  h2 { font-size: clamp(1.7rem, 3vw, 2.4rem); }
  .logos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1px; background: var(--steel-2); border: 1px solid var(--steel-2); }
  .logos li { background: var(--white); aspect-ratio: 3 / 2; display: grid; place-items: center; padding: 14px; }
  .logos img { max-height: 54px; width: auto; object-fit: contain; filter: grayscale(1); opacity: .72; transition: filter .25s, opacity .25s; }
  .logos li:hover img { filter: none; opacity: 1; }
  @media (max-width: 900px) { .in { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .logos { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
