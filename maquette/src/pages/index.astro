---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Preuves from '../components/Preuves.astro';
import Clients from '../components/Clients.astro';
import Expertises from '../components/Expertises.astro';
import Secteurs from '../components/Secteurs.astro';
import Acheteurs from '../components/Acheteurs.astro';
import Methode from '../components/Methode.astro';
import EtudeCas from '../components/EtudeCas.astro';
import Implantations from '../components/Implantations.astro';
import Conformite from '../components/Conformite.astro';
import Recrutement from '../components/Recrutement.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Diamond Protect · Sécurité privée, événementiel et sûreté de sites"
  description="Sécurité événementielle, gardiennage, sûreté et sécurité incendie. Entreprise autorisée par le CNAPS, 220 collaborateurs, astreinte 24h/24, partout en France."
>
  <Header />
  <main>
    <Hero />
    <Preuves />
    <Clients />
    <Expertises />
    <Secteurs />
    <Acheteurs />
    <Methode />
    <EtudeCas />
    <Implantations />
    <Conformite />
    <Recrutement />
    <Contact />
  </main>
  <Footer />
</Base>
